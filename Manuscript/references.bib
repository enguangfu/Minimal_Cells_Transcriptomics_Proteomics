@article{gilbert_generating_2021,
	title = {Generating {Chromosome} {Geometries} in a {Minimal} {Cell} {From} {Cryo}-{Electron} {Tomograms} and {Chromosome} {Conformation} {Capture} {Maps}},
	volume = {8},
	issn = {2296-889X},
	url = {https://www.frontiersin.org/articles/10.3389/fmolb.2021.644133/full},
	doi = {10.3389/fmolb.2021.644133},
	abstract = {JCVI-syn3A is a genetically minimal bacterial cell, consisting of 493 genes and only a single 543 kbp circular chromosome. Syn3A’s genome and physical size are approximately one-tenth those of the model bacterial organism
              Escherichia coli
              ’s, and the corresponding reduction in complexity and scale provides a unique opportunity for whole-cell modeling. Previous work established genome-scale gene essentiality and proteomics data along with its essential metabolic network and a kinetic model of genetic information processing. In addition to that information, whole-cell, spatially-resolved kinetic models require cellular architecture, including spatial distributions of ribosomes and the circular chromosome’s configuration. We reconstruct cellular architectures of Syn3A cells at the single-cell level directly from cryo-electron tomograms, including the ribosome distributions. We present a method of generating self-avoiding circular chromosome configurations in a lattice model with a resolution of 11.8 bp per monomer on a 4 nm cubic lattice. Realizations of the chromosome configurations are constrained by the ribosomes and geometry reconstructed from the tomograms and include DNA loops suggested by experimental chromosome conformation capture (3C) maps. Using ensembles of simulated chromosome configurations we predict chromosome contact maps for Syn3A cells at resolutions of 250 bp and greater and compare them to the experimental maps. Additionally, the spatial distributions of ribosomes and the DNA-crowding resulting from the individual chromosome configurations can be used to identify macromolecular structures formed from ribosomes and DNA, such as polysomes and expressomes.},
	language = {en},
	urldate = {2025-01-22},
	journal = {Front. Mol. Biosci.},
	author = {Gilbert, Benjamin R. and Thornburg, Zane R. and Lam, Vinson and Rashid, Fatema-Zahra M. and Glass, John I. and Villa, Elizabeth and Dame, Remus T. and Luthey-Schulten, Zaida},
	month = jul,
	year = {2021},
	pages = {644133},
	file = {PDF:/home/enguang/Zotero/storage/K2LDHSNY/Gilbert et al. - 2021 - Generating Chromosome Geometries in a Minimal Cell From Cryo-Electron Tomograms and Chromosome Confo.pdf:application/pdf},
}

@article{stevens_molecular_2023,
