@article{aseev_extraribosomal_2024,
	title = {Extraribosomal {Functions} of {Bacterial} {Ribosomal} {Proteins}—{An} {Update}, 2023},
	volume = {25},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {1422-0067},
	url = {https://www.mdpi.com/1422-0067/25/5/2957},
	doi = {10.3390/ijms25052957},
	abstract = {Ribosomal proteins (r-proteins) are abundant, highly conserved, and multifaceted cellular proteins in all domains of life. Most r-proteins have RNA-binding properties and can form protein–protein contacts. Bacterial r-proteins govern the co-transcriptional rRNA folding during ribosome assembly and participate in the formation of the ribosome functional sites, such as the mRNA-binding site, tRNA-binding sites, the peptidyl transferase center, and the protein exit tunnel. In addition to their primary role in a cell as integral components of the protein synthesis machinery, many r-proteins can function beyond the ribosome (the phenomenon known as moonlighting), acting either as individual regulatory proteins or in complexes with various cellular components. The extraribosomal activities of r-proteins have been studied over the decades. In the past decade, our understanding of r-protein functions has advanced significantly due to intensive studies on ribosomes and gene expression mechanisms not only in model bacteria like Escherichia coli or Bacillus subtilis but also in little-explored bacterial species from various phyla. The aim of this review is to update information on the multiple functions of r-proteins in bacteria.},
	language = {en},
	number = {5},
	urldate = {2025-10-15},
	journal = {International Journal of Molecular Sciences},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Aseev, Leonid V. and Koledinskaya, Ludmila S. and Boni, Irina V.},
	month = jan,
	year = {2024},
	keywords = {bacterial ribosomal proteins, extraribosomal functions, protein–protein interactions, regulation of gene expression, RNA–protein interactions},
	pages = {2957},
	file = {Full Text PDF:/home/enguang/Zotero/storage/YGLNJ8P9/Aseev et al. - 2024 - Extraribosomal Functions of Bacterial Ribosomal Proteins—An Update, 2023.pdf:application/pdf},
}

