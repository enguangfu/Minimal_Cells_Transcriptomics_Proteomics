@article{safronova_temperature_2024,
	title = {Temperature change elicits lipidome adaptation in the simple organisms {Mycoplasma} mycoides and {JCVI}-{syn3B}},
	volume = {43},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {2211-1247},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2211124724007642},
	doi = {10.1016/j.celrep.2024.114435},
	abstract = {Cell membranes mediate interactions between life and its environment, with lipids determining their properties. Understanding how cells adjust their lipidomes to tune membrane properties is crucial yet poorly deﬁned due to the complexity of most organisms. We used quantitative shotgun lipidomics to study temperature adaptation in the simple organism Mycoplasma mycoides and the minimal cell JCVI-syn3B. We show that lipid abundances follow a universal logarithmic distribution across eukaryotes and bacteria, with comparable degrees of lipid remodeling for adaptation regardless of lipidomic or organismal complexity. Lipid features analysis demonstrates head-group-speciﬁc acyl chain remodeling as characteristic of lipidome adaptation; its deﬁciency in Syn3B is associated with impaired homeoviscous adaptation. Temporal analysis reveals a two-stage cold adaptation process: swift cholesterol and cardiolipin shifts followed by gradual acyl chain modiﬁcations. This work provides an in-depth analysis of lipidome adaptation in minimal cells, laying a foundation to probe the design principles of living membranes.},
	language = {en},
	number = {7},
	urldate = {2025-07-21},
	journal = {Cell Reports},
	publisher = {Elsevier BV},
	author = {Safronova, Nataliya and Junghans, Lisa and Saenz, James P.},
	month = jul,
	year = {2024},
	pages = {114435},
	file = {2024_Temperature change elicits lipidome adaptation.pdf:/home/enguang/Zotero/storage/8LK2GISI/2024_Temperature change elicits lipidome adaptation.pdf:application/pdf},
}

@article{yaginuma_diversity_2014,
