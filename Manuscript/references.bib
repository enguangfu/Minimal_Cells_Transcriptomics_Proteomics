	issn = {0036-8075, 1095-9203},
	url = {https://www.science.org/doi/10.1126/science.1190719},
	doi = {10.1126/science.1190719},
	abstract = {Let There Be Life
            
              The DNA sequence information from thousands of genomes is stored digitally as ones and zeros in computer memory. Now,
              
