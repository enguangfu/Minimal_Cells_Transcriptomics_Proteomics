@article{wohlgemuth_studying_2015,
	title = {Studying macromolecular complex stoichiometries by peptide‐based mass spectrometry},
	volume = {15},
	issn = {1615-9853, 1615-9861},
	url = {https://analyticalsciencejournals.onlinelibrary.wiley.com/doi/10.1002/pmic.201400466},
	doi = {10.1002/pmic.201400466},
	abstract = {A majority of cellular functions are carried out by macromolecular complexes. A host of biochemical and spectroscopic methods exists to characterize especially protein/protein complexes, however there has been a lack of a universal method to determine protein stoichiometries. Peptide‐based MS, especially as a complementary method to the MS analysis of intact protein complexes, has now been developed to a point where it can be employed to assay protein stoichiometries in a routine manner. While the experimental demands are still significant, peptide‐based MS has been successfully applied to analyze stoichiometries for a variety of protein complexes from very different biological backgrounds. In this review, we discuss the requirements especially for targeted MS acquisition strategies to be used in this context, with a special focus on the interconnected experimental aspects of sample preparation, protein digestion, and peptide stability. In addition, different strategies for the introduction of quantitative peptide standards and their suitability for different scenarios are compared.},
	language = {en},
	number = {5-6},
	urldate = {2025-03-18},
	journal = {Proteomics},
	author = {Wohlgemuth, Ingo and Lenz, Christof and Urlaub, Henning},
	month = mar,
