@article{serdiuk_insertion_2019,
	title = {Insertion and folding pathways of single membrane proteins guided by translocases and insertases},
	volume = {5},
	issn = {2375-2548},
	url = {https://www.science.org/doi/10.1126/sciadv.aau6824},
	doi = {10.1126/sciadv.aau6824},
	abstract = {We observe how translocon and insertase insert single polypeptides along remarkably different pathways to fold membrane proteins.
          , 
            Biogenesis in prokaryotes and eukaryotes requires the insertion of α-helical proteins into cellular membranes for which they use universally conserved cellular machineries. In bacterial inner membranes, insertion is facilitated by YidC insertase and SecYEG translocon working individually or cooperatively. How insertase and translocon fold a polypeptide into the native protein in the membrane is largely unknown. We apply single-molecule force spectroscopy assays to investigate the insertion and folding process of single lactose permease (LacY) precursors assisted by YidC and SecYEG. Both YidC and SecYEG initiate folding of the completely unfolded polypeptide by inserting a single structural segment. YidC then inserts the remaining segments in random order, whereas SecYEG inserts them sequentially. Each type of insertion process proceeds until LacY folding is complete. When YidC and SecYEG cooperate, the folding pathway of the membrane protein is dominated by the translocase. We propose that both of the fundamentally different pathways along which YidC and SecYEG insert and fold a polypeptide are essential components of membrane protein biogenesis.},
	language = {en},
	number = {1},
	urldate = {2025-02-06},
	journal = {Sci. Adv.},
	author = {Serdiuk, Tetiana and Steudle, Anja and Mari, Stefania A. and Manioglu, Selen and Kaback, H. Ronald and Kuhn, Andreas and Müller, Daniel J.},
	month = jan,
	year = {2019},
	pages = {eaau6824},
	file = {PDF:/home/enguang/Zotero/storage/6LUM2BWW/Serdiuk et al. - 2019 - Insertion and folding pathways of single membrane proteins guided by translocases and insertases.pdf:application/pdf},
}

@article{morellet_structural_2022,
	title = {Structural {Insights} into the {Dimeric} {Form} of {Bacillus} subtilis {RNase} {Y} {Using} {NMR} and {AlphaFold}},
	volume = {12},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	issn = {2218-273X},
	url = {https://www.mdpi.com/2218-273X/12/12/1798},
	doi = {10.3390/biom12121798},
	abstract = {RNase Y is a crucial component of genetic translation, acting as the key enzyme initiating mRNA decay in many Gram-positive bacteria. The N-terminal domain of Bacillus subtilis RNase Y (Nter-BsRNaseY) is thought to interact with various protein partners within a degradosome complex. Bioinformatics and biophysical analysis have previously shown that Nter-BsRNaseY, which is in equilibrium between a monomeric and a dimeric form, displays an elongated fold with a high content of α-helices. Using multidimensional heteronuclear NMR and AlphaFold models, here, we show that the Nter-BsRNaseY dimer is constituted of a long N-terminal parallel coiled-coil structure, linked by a turn to a C-terminal region composed of helices that display either a straight or bent conformation. The structural organization of the N-terminal domain is maintained within the AlphaFold model of the full-length RNase Y, with the turn allowing ﬂexibility between the N- and C-terminal domains. The catalytic domain is globular, with two helices linking the KH and HD modules, followed by the C-terminal region. This latter region, with no function assigned up to now, is most likely involved in the dimerization of B. subtilis RNase Y together with the N-terminal coiled-coil structure.},
	language = {en},
	number = {12},
	urldate = {2025-02-07},
	journal = {Biomolecules},
	author = {Morellet, Nelly and Hardouin, Pierre and Assrir, Nadine and Van Heijenoort, Carine and Golinelli-Pimpaneau, Béatrice},
	month = dec,
	year = {2022},
	pages = {1798},
	file = {PDF:/home/enguang/Zotero/storage/4WR47RTV/Morellet et al. - 2022 - Structural Insights into the Dimeric Form of Bacillus subtilis RNase Y Using NMR and AlphaFold.pdf:application/pdf},
}

