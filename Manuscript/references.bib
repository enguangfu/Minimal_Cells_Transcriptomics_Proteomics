	month = jan,
	year = {2022},
	keywords = {JCVI-syn3A, genetic information processing, hybrid stochastic-deterministic simulations, metabolism, minimal cell, mRNA half-lives, qPCR, time-dependent ATP costs, whole-cell kinetic model},
	pages = {345--360.e28},
	file = {mmc1:/home/enguang/Zotero/storage/KM9FTWY6/mmc1.xlsx:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;PDF:/home/enguang/Zotero/storage/SX8PKVYH/Thornburg et al. - 2022 - Fundamental behaviors emerge from simulations of a living minimal cell.pdf:application/pdf;Reviewer_Responses:/home/enguang/Zotero/storage/KHVMNAIV/Reviewer_Responses.pdf:application/pdf;Reviewer_Responses_2:/home/enguang/Zotero/storage/HE6Y7PR9/Reviewer_Responses_2.pdf:application/pdf;Thornburg-2022-Fundamental-behaviors-emerge-from-s.pdf:/Users/fusdefaultfolder/Library/CloudStorage/OneDrive-UniversityofIllinois-Urbana/ZLS Research/Articles/ZLS Publication/Cell/Thornburg-2022-Fundamental-behaviors-emerge-from-s.pdf:application/pdf},
