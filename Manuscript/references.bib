	journal = {Cell},
	author = {Diaconu, Mihaela and Kothe, Ute and Schlünzen, Frank and Fischer, Niels and Harms, Jörg M. and Tonevitsky, Alexander G. and Stark, Holger and Rodnina, Marina V. and Wahl, Markus C.},
	month = jul,
