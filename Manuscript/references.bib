	journal = {Journal of Biological Chemistry},
	publisher = {Elsevier},
	author = {Akiyama, Yoshinori and Kihara, Akio and Tokuda, Hajime and Ito, Koreaki},
	month = dec,
	year = {1996},
	pages = {31196--31201},
	file = {Full Text PDF:/home/enguang/Zotero/storage/NAW9KLVL/Akiyama et al. - 1996 - FtsH (HflB) Is an ATP-dependent Protease Selective.pdf:application/pdf;PDF:/home/enguang/Zotero/storage/SIPZTDYE/Akiyama et al. - 1996 - FtsH (HflB) Is an ATP-dependent Protease Selectively Acting on SecY and Some Other Membrane Proteins.pdf:application/pdf},
