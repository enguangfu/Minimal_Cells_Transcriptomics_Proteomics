	author = {Sutormin, Dmitry and Galivondzhyan, Alina and Musharova, Olga and Travin, Dmitrii and Rusanova, Anastasiia and Obraztsova, Kseniya and Borukhov, Sergei and Severinov, Konstantin},
	month = aug,
