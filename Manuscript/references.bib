	author = {Von Heijne, Gunnar},
	month = nov,
	year = {1999},
	pages = {285--307},
	file = {PDF:/home/enguang/Zotero/storage/GIZHTZCA/Von Heijne - 1999 - Recent advances in the understanding of membrane protein assembly and structure.pdf:application/pdf},
}

