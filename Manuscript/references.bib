	keywords = {Synthetic biology, Computer modelling, Genomic engineering},
	pages = {836},
	file = {Full Text PDF:/home/enguang/Zotero/storage/XLT5ASCJ/Rees-Garbutt et al. - 2020 - Designing minimal genomes using whole-cell models.pdf:application/pdf},
}

