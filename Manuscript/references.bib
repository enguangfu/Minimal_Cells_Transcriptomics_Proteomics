	year = {2016},
	keywords = {transcriptome, fluorescence in situ hybridization, next-generation sequencing, RNA degradation, spatial organization, superresolution microscopy},
	pages = {e13065},
	file = {Full Text PDF:/home/enguang/Zotero/storage/RTHPFXVL/Moffitt et al. - 2016 - Spatial organization shapes the turnover of a bacterial transcriptome.pdf:application/pdf},
}

