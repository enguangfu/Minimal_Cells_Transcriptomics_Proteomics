	file = {PDF:/home/enguang/Zotero/storage/GDQB6KHG/Knyazev et al. - 2018 - Driving Forces of Translocation Through Bacterial Translocon SecYEG.pdf:application/pdf},
}

@article{oswald_dynamic_2021,
