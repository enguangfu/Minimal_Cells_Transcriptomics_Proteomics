	file = {PDF:/home/enguang/Zotero/storage/LWGTRHDF/Van Der Laan et al. - 2004 - F1F0 ATP synthase subunit c is a substrate of the novel YidC pathway for membrane protein biogenesis.pdf:application/pdf},
}

