@article{lalanne_evolutionary_2018,
	title = {Evolutionary {Convergence} of {Pathway}-{Specific} {Enzyme} {Expression} {Stoichiometry}},
	volume = {173},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {0092-8674, 1097-4172},
	url = {https://www.cell.com/cell/abstract/S0092-8674(18)30287-3},
	doi = {10.1016/j.cell.2018.03.007},
	abstract = {Coexpression of proteins in response to pathwayinducing signals is the founding paradigm of gene regulation. However, it remains unexplored whether the relative abundance of co-regulated proteins requires precise tuning. Here, we present large-scale analyses of protein stoichiometry and corresponding regulatory strategies for 21 pathways and 67–224 operons in divergent bacteria separated by 0.6–2 billion years. Using end-enriched RNA-sequencing (Rend-seq) with single-nucleotide resolution, we found that many bacterial gene clusters encoding conserved pathways have undergone massive divergence in transcript abundance and architectures via remodeling of internal promoters and terminators. Remarkably, these evolutionary changes are compensated post-transcriptionally to maintain preferred stoichiometry of protein synthesis rates. Even more strikingly, in eukaryotic budding yeast, functionally analogous proteins that arose independently from bacterial counterparts also evolved to convergent in-pathway expression. The broad requirement for exact protein stoichiometries despite regulatory divergence provides an unexpected principle for building biological pathways both in nature and for synthetic activities.},
	language = {English},
	number = {3},
	urldate = {2025-12-03},
	journal = {Cell},
	publisher = {Elsevier},
	author = {Lalanne, Jean-Benoît and Taggart, James C. and Guo, Monica S. and Herzel, Lydia and Schieler, Ariel and Li, Gene-Wei},
	month = apr,
	year = {2018},
	keywords = {ribosome profiling, end-enriched RNA-seq, Enzyme expression stoichiometry, operon evolution, Rend-seq},
	pages = {749--761.e38},
	file = {1-s2.0-S0092867418302873-mmc1:/home/enguang/Zotero/storage/EQY4Q4IR/1-s2.0-S0092867418302873-mmc1.xlsx:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;1-s2.0-S0092867418302873-mmc2:/home/enguang/Zotero/storage/3CY5QX7Y/1-s2.0-S0092867418302873-mmc2.xlsx:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;1-s2.0-S0092867418302873-mmc3:/home/enguang/Zotero/storage/M7ME4VUI/1-s2.0-S0092867418302873-mmc3.xlsx:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;1-s2.0-S0092867418302873-mmc5:/home/enguang/Zotero/storage/EZAK7WTV/1-s2.0-S0092867418302873-mmc5.pdf:application/pdf;Full Text PDF:/home/enguang/Zotero/storage/ZVFFWIEZ/Lalanne et al. - 2018 - Evolutionary Convergence of Pathway-Specific Enzyme Expression Stoichiometry.pdf:application/pdf},
