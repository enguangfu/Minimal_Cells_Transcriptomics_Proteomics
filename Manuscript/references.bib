	journal = {Protein Science},
	author = {Yang, Yiqing and Gunasekara, Mihiravi and Muhammednazaar, Shaima and Li, Zhen and Hong, Heedeok},
	month = jul,
	year = {2019},
	pages = {1262--1275},
	file = {PDF:/home/enguang/Zotero/storage/KPGP5KRZ/Yang et al. - 2019 - Proteolysis mediated by the membrane‐integrated ATP‐dependent protease FtsH has a unique nonlinear d.pdf:application/pdf},
}

