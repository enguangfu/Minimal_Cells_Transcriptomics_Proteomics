	keywords = {Langevin equation, master equation, stiff systems, tau-leaping},
	pages = {35--55},
	file = {PDF:/home/enguang/Zotero/storage/QIKDFSCQ/Gillespie - 2007 - Stochastic Simulation of Chemical Kinetics.pdf:application/pdf},
}

